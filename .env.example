# =============================================================================
# Rare Scents – Umgebungsvariablen
# =============================================================================
#
# HINWEIS FÜR DEN IMPORT IN VERCEL
# Vercel liest diese Datei und schlägt beim Anlegen des Projekts alle Schlüssel
# als Zeilen vor. Zeilen, die du nicht brauchst, bitte **entfernen** statt leer
# stehen zu lassen. Der Code fängt leere Werte zwar ab (siehe src/lib/env.ts),
# aber eine gelöschte Zeile ist eindeutiger als eine leere.
#
# Zwingend nötig sind nur vier Werte:
#   DATABASE_URL, DIRECT_URL, AUTH_SECRET, NEXT_PUBLIC_SITE_URL
# =============================================================================
# Diese Datei nach `.env` kopieren und ausfüllen:
#   cp .env.example .env
#
# WICHTIG: `.env` niemals ins Git-Repository committen.
# Nur Variablen mit dem Präfix NEXT_PUBLIC_ landen im Browser-Bundle.
# Alle übrigen Werte bleiben ausschliesslich serverseitig.
# =============================================================================

# -----------------------------------------------------------------------------
# Datenbank (Supabase, Neon oder eigenes PostgreSQL)
# -----------------------------------------------------------------------------
# Laufzeit-Verbindung. Bei Supabase/Neon die gepoolte Verbindung verwenden
# (Port 6543 bei Supabase, "-pooler" im Host bei Neon).
DATABASE_URL="postgresql://postgres:passwort@localhost:5432/rarescents?schema=public"

# Direkte Verbindung ohne Pooler – wird nur von `prisma migrate` benötigt.
# Bei lokalem PostgreSQL identisch mit DATABASE_URL.
DIRECT_URL="postgresql://postgres:passwort@localhost:5432/rarescents?schema=public"

# -----------------------------------------------------------------------------
# Auth.js (Admin-Anmeldung)
# -----------------------------------------------------------------------------
# Zufälliges Secret erzeugen mit:  openssl rand -base64 32
AUTH_SECRET="hier-ein-langes-zufaelliges-secret-einsetzen"

# Öffentliche Basis-URL des Shops (ohne abschliessenden Slash).
# Lokal: http://localhost:3000 – in Produktion: https://www.deine-domain.ch
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Wird von Auth.js hinter Proxies benötigt (auf Vercel identisch zur Site-URL).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# Stripe (Zahlungen)
# -----------------------------------------------------------------------------
# Dashboard -> Entwickler -> API-Schlüssel
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Signatur-Secret des Webhook-Endpunkts (Dashboard -> Entwickler -> Webhooks).
# Lokal liefert `stripe listen` ein eigenes whsec_... aus.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Zahlungsarten im Checkout.
#
# Leer lassen oder "auto": Es gelten die Zahlungsarten, die du im
# Stripe-Dashboard unter "Zahlungsmethoden" freischaltest. TWINT, PayPal und
# alles Weitere aktivierst du dort mit einem Haken – ohne Codeänderung und
# ohne neues Deployment. Stripe blendet automatisch aus, was zur Währung oder
# zum Land der Kundin nicht passt.
#
# Nur wenn du die Auswahl fest vorgeben willst, hier eine Liste eintragen:
#   STRIPE_PAYMENT_METHODS="card,twint"
STRIPE_PAYMENT_METHODS="auto"

# -----------------------------------------------------------------------------
# Resend (Transaktions-E-Mails)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
# Absenderadresse einer in Resend verifizierten Domain.
EMAIL_FROM="Rare Scents <bestellungen@deine-domain.ch>"
# Interne Adresse für Bestellbenachrichtigungen.
SHOP_NOTIFICATION_EMAIL="bestellungen@deine-domain.ch"

# -----------------------------------------------------------------------------
# Cloudinary (Produktbilder)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="dein-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="dein-api-secret"
# Der Cloud-Name darf öffentlich sein – er steht in jeder Bild-URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="dein-cloud-name"
# Zielordner im Cloudinary-Medienarchiv.
CLOUDINARY_UPLOAD_FOLDER="rare-scents/produkte"

# -----------------------------------------------------------------------------
# Shop-Einstellungen
# -----------------------------------------------------------------------------
# Mehrwertsteuersatz in Basispunkten (810 = 8,10 % CH, 1900 = 19,00 % DE,
# 2000 = 20,00 % AT).
#
# 0 = nicht mehrwertsteuerpflichtig. Das ist die aktuelle Einstellung: Ohne
# UID und ohne MwSt-Registrierung darf keine Mehrwertsteuer ausgewiesen
# werden. Der Shop blendet dann sämtliche MwSt-Angaben aus und schreibt
# stattdessen «keine MwSt.». Sobald die Steuerpflicht eintritt (Umsatz ab
# CHF 100'000 pro Jahr), hier auf 810 setzen.
SHOP_TAX_RATE_BP="0"
# Preise sind Bruttopreise inkl. der oben gesetzten Mehrwertsteuer.
SHOP_PRICES_INCLUDE_TAX="true"

# Anzeigewährungen für den Umschalter im Shop.
#
# Abgerechnet wird IMMER in CHF – diese Kurse betreffen ausschliesslich die
# Anzeige und sind mit «ca.» gekennzeichnet. Format: <ISO-Code>:<Einheiten
# je 1 CHF>, mit Komma getrennt.
#
# SHOP_DISPLAY_RATES="aus"  schaltet den Umschalter ab, der Shop zeigt nur CHF.
# Ein leerer Wert schaltet nichts ab, sondern greift auf die in
# src/config/currencies.ts hinterlegten Näherungskurse zurück.
#
# ⚠️ Kurse veralten – regelmässig prüfen und aktualisieren.
SHOP_DISPLAY_RATES="EUR:1.07,USD:1.24,GBP:0.92"

# Hintergrund in Produktfotos.
#
#   keep         Foto bleibt wie es ist. Standard und sicherste Wahl.
#   transparent  Eine gleichmässige Fläche (z. B. weisser Tisch) wird entfernt
#                und durch die Shop-Farbe ersetzt. Funktioniert in jedem
#                Cloudinary-Tarif, verlangt aber einen ruhigen, einfarbigen
#                Hintergrund ohne Schatten.
#   ai           Cloudinary schneidet den Gegenstand frei, auch bei unruhigem
#                Hintergrund. Setzt das kostenpflichtige Zusatzmodul
#                "Background Removal" voraus.
#
# ⚠️ Diese Einstellung wirkt auf ALLE Bilder gleichzeitig. Prüfe nach dem
# Umstellen ein paar Produktseiten – ein danebengegangenes Freistellen fällt
# sonst erst auf, wenn Kundinnen es sehen.
SHOP_IMAGE_BACKGROUND="keep"

# Nur bei "transparent": Wie viel Farbabweichung noch als Hintergrund gilt
# (1–100). Höher entfernt mehr, greift aber irgendwann den Flakon an.
SHOP_IMAGE_BACKGROUND_TOLERANCE="30"

# -----------------------------------------------------------------------------
# Optional: Rate-Limiting über Upstash Redis
# -----------------------------------------------------------------------------
# Ohne diese Werte greift ein prozesslokales Limit (siehe src/lib/rate-limit.ts).
# Auf Vercel mit mehreren Instanzen wird Redis dringend empfohlen.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Cron / Wartung
# -----------------------------------------------------------------------------
# Schützt /api/cron/* – muss als Bearer-Token mitgesendet werden.
CRON_SECRET="langes-zufaelliges-token"
